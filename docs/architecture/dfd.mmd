flowchart LR;
    C["Cliente: origem não confiável"];
    subgraph HOST["Fronteira de confiança: host da aplicação"];
        subgraph APP["Processo FastAPI"];
            API["Entrada HTTP: middleware, validação e rotas"];
            LOGIN["POST /auth/token: limite de tentativas, senha e emissão JWT"];
            PRED["Rotas de predição: validação JWT, placeholder e ownership"];
            HEALTH["GET /health: status estático"];
        end;
        DB[("Arquivo SQLite: usuários e predições")];
    end;
    C -->|"Formulário, Bearer, JSON ou ID"| API;
    API -->|"Credenciais"| LOGIN;
    LOGIN <-->|"SQLModel: usuário e hash de senha"| DB;
    LOGIN -->|"JWT ou erro"| API;
    API -->|"Bearer e mensagem ou ID"| PRED;
    PRED <-->|"SQLModel: usuário e registros de predição"| DB;
    PRED -->|"ID, intenção e confiança ou erro"| API;
    API -->|"Consulta pública"| HEALTH;
    HEALTH -->|"Status e nome do serviço"| API;
    API -->|"Resposta HTTP com headers de segurança"| C;
