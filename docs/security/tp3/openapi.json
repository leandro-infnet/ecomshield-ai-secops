{
  "openapi": "3.1.0",
  "info": {
    "title": "E-ComShield API",
    "description": "API demonstrativa consolidada no TP3. Autenticação JWT, registro de predições placeholder e consulta por proprietário. Ainda não há classificador treinado. Use somente dados sintéticos nos testes.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Operacional"
        ],
        "summary": "Verifica a disponibilidade da API",
        "description": "Rota pública de disponibilidade do processo. Não verifica serviços externos ou modelo de ML.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Gera token JWT",
        "description": "Recebe formulário OAuth2 de usuário e senha. Cinco tentativas por IP de conexão em 60 segundos; a sexta retorna 429. Não concede escopos ou autentica aplicações clientes.",
        "operationId": "login_for_access_token_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido",
            "headers": {
              "Retry-After": {
                "description": "Segundos até nova tentativa",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Predições"
        ],
        "summary": "Registra predição demonstrativa",
        "description": "Exige JWT válido. Persiste o texto e um resultado placeholder associado ao usuário autenticado. Não executa inferência de ML; o proprietário não pode ser informado pelo cliente.",
        "operationId": "predict_intent_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/predictions/{prediction_id}": {
      "get": {
        "tags": [
          "Predições"
        ],
        "summary": "Consulta predição própria",
        "description": "Exige JWT válido e filtra ID e proprietário. Recurso inexistente ou pertencente a outro usuário retorna o mesmo erro 404.",
        "operationId": "get_prediction_predictions__prediction_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Prediction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Predição não encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Descrição do erro, sem credenciais ou tokens"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "servico": {
            "type": "string",
            "title": "Servico"
          }
        },
        "type": "object",
        "required": [
          "status",
          "servico"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "const": "password"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Secret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PredictRequest": {
        "properties": {
          "texto_cliente": {
            "type": "string",
            "maxLength": 100,
            "minLength": 5,
            "title": "Texto Cliente",
            "description": "Mensagem do cliente; de 5 a 100 caracteres",
            "examples": [
              "Onde esta meu pedido?"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "texto_cliente"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "intencao_prevista": {
            "type": "string",
            "title": "Intencao Prevista",
            "description": "Placeholder demonstrativo; não é classificação por modelo treinado"
          },
          "confianca": {
            "type": "number",
            "title": "Confianca",
            "description": "Valor demonstrativo 0.0; não é probabilidade calibrada"
          }
        },
        "type": "object",
        "required": [
          "id",
          "intencao_prevista",
          "confianca"
        ],
        "title": "PredictResponse"
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token",
            "description": "JWT a enviar no header Authorization: Bearer <token>"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Tipo do token: bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type"
        ],
        "title": "Token"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/auth/token"
          }
        }
      }
    }
  }
}
